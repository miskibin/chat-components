{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "chat-components",
  "homepage": "https://github.com/miskibin/chat-components",
  "items": [
    {
      "name": "chat-input",
      "type": "registry:ui",
      "title": "Chat Input",
      "description": "Composer-style chat input with attachments, optional skills/slash menu, and send/stop.",
      "dependencies": ["lucide-react"],
      "files": [
        {
          "path": "components/ui/chat-input.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "message",
      "type": "registry:ui",
      "title": "Message",
      "description": "User bubble and assistant markdown with collapsed reasoning, tool calls, code blocks, and artifacts.",
      "dependencies": ["lucide-react", "react-markdown", "shiki", "next-themes"],
      "registryDependencies": ["collapsible"],
      "files": [
        {
          "path": "components/ui/message.tsx",
          "type": "registry:ui"
        },
        {
          "path": "components/ui/message-parts.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "generation-status",
      "type": "registry:ui",
      "title": "Generation Status",
      "description": "Braille spinner for AI generation status.",
      "files": [
        {
          "path": "components/ui/generation-status.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "message-list",
      "type": "registry:ui",
      "title": "Message List",
      "description": "Scrollable message list with smart auto-scroll and generation status.",
      "registryDependencies": [
        "miskibin/chat-components/message",
        "miskibin/chat-components/generation-status"
      ],
      "files": [
        {
          "path": "components/ui/message-list.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "model-picker",
      "type": "registry:ui",
      "title": "Model Picker",
      "description": "Dropdown model selector with badge, description, and optional disabled options.",
      "dependencies": ["lucide-react"],
      "files": [
        {
          "path": "components/ui/model-picker.tsx",
          "type": "registry:ui"
        },
        {
          "path": "hooks/use-click-outside.ts",
          "type": "registry:hook"
        }
      ]
    },
    {
      "name": "chat-sidebar",
      "type": "registry:ui",
      "title": "Chat Sidebar",
      "description": "Collapsible sidebar chrome with DnD pin/trash zones, polished items, and slot-based composition.",
      "dependencies": [
        "lucide-react",
        "@dnd-kit/core",
        "@dnd-kit/utilities",
        "@radix-ui/react-context-menu"
      ],
      "files": [
        {
          "path": "components/ui/chat-sidebar.tsx",
          "type": "registry:ui"
        },
        {
          "path": "components/ui/sidebar-item.tsx",
          "type": "registry:ui"
        },
        {
          "path": "components/ui/sidebar-dnd.tsx",
          "type": "registry:ui"
        },
        {
          "path": "components/ui/sidebar-drop-zones.tsx",
          "type": "registry:ui"
        },
        {
          "path": "components/ui/context-menu.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "theme-toggle",
      "type": "registry:ui",
      "title": "Theme Toggle",
      "description": "Floating circular theme chip (light/dark).",
      "dependencies": ["lucide-react", "next-themes"],
      "files": [
        {
          "path": "components/ui/theme-toggle.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "chat-navbar",
      "type": "registry:ui",
      "title": "Chat Navbar",
      "description": "Thin top bar with title and action slots (optional; prefer ThemeToggle for minimal chrome).",
      "files": [
        {
          "path": "components/ui/chat-navbar.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "chat",
      "type": "registry:ui",
      "title": "Chat",
      "description": "Full chat UI kit: input, messages, sidebar, navbar, and model picker.",
      "dependencies": [
        "lucide-react",
        "react-markdown",
        "shiki",
        "next-themes",
        "@dnd-kit/core",
        "@dnd-kit/utilities",
        "@radix-ui/react-context-menu"
      ],
      "registryDependencies": ["collapsible"],
      "files": [
        {
          "path": "components/ui/chat-input.tsx",
          "type": "registry:ui"
        },
        {
          "path": "components/ui/message.tsx",
          "type": "registry:ui"
        },
        {
          "path": "components/ui/message-parts.tsx",
          "type": "registry:ui"
        },
        {
          "path": "components/ui/generation-status.tsx",
          "type": "registry:ui"
        },
        {
          "path": "components/ui/message-list.tsx",
          "type": "registry:ui"
        },
        {
          "path": "components/ui/model-picker.tsx",
          "type": "registry:ui"
        },
        {
          "path": "components/ui/chat-sidebar.tsx",
          "type": "registry:ui"
        },
        {
          "path": "components/ui/sidebar-item.tsx",
          "type": "registry:ui"
        },
        {
          "path": "components/ui/sidebar-dnd.tsx",
          "type": "registry:ui"
        },
        {
          "path": "components/ui/sidebar-drop-zones.tsx",
          "type": "registry:ui"
        },
        {
          "path": "components/ui/context-menu.tsx",
          "type": "registry:ui"
        },
        {
          "path": "components/ui/chat-navbar.tsx",
          "type": "registry:ui"
        },
        {
          "path": "components/ui/theme-toggle.tsx",
          "type": "registry:ui"
        },
        {
          "path": "hooks/use-click-outside.ts",
          "type": "registry:hook"
        }
      ]
    }
  ]
}
